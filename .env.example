# untangle — environment template. Copy to `.env` (gitignored) and fill in only what you use.
# The deterministic engine needs NONE of these; they are only for the optional --ai edge tier.
#
# NEVER commit a real `.env`. Rotate any key that has ever been shared or exposed.

# Optional LLM providers for the edge narration tier (`untangle run --ai`). Pick ONE.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
GROQ_API_KEY=gsk_your-key-here
CEREBRAS_API_KEY=csk-your-key-here
GEMINI_API_KEY=your-key-here

# Internal review tooling only (not used by the engine or web app).
AGENTROUTER_API_KEY=sk-your-key-here
